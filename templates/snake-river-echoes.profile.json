{
  "version": 1,
  "pattern": "SRE_Vol{group}",
  "checks": {
    "sequence": {
      "patterns": ["{year}_Vol{group}_No{part}", "{year}_Vol{group}_Num{part}"],
      "labels": { "part": "issue", "group": "volume" }
    }
  },
  "aiInstruction": "Summarise the subjects the issues cover -- the topics, places, people, events and periods -- in one or two sentences of plain prose. Do not repeat the journal's title or the volume number, which are already given. Do not list article titles.",
  "aiProvenance": {
    "path": "MWDL/conversionSpecifications",
    "append": "Description partly generated by a language model ({model})"
  },
  "columns": [
    { "path": "attachment name", "sources": [{ "filename": true }], "locked": true },
    { "path": "MWDL/identifier", "sources": [{ "filename": true }] },
    { "path": "MWDL/title", "sources": [{ "join": "Snake River Echoes, Volume {group}" }, { "filenameStem": true }] },
    { "path": "MWDL/description", "sources": [{ "join": "Upper Snake River Valley Historical Society Quarterly, Volume {group}." }, { "ai": true, "after": true }] },
    { "path": "MWDL/genres/genre", "sources": [], "default": "Periodical" },
    { "path": "MWDL/conversionSpecifications", "sources": [], "default": "Scanned to PDF" },
    { "path": "MWDL/source", "sources": [], "default": "None" },
    { "path": "BYUI_extended/byui_rights/restrict_to_byui", "sources": [], "default": "Public" }
  ]
}
