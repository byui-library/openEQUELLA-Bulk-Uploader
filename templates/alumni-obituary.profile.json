{
  "version": 1,
  "pattern": "{first} {last} Obituary.pdf",
  "checks": { "filenameWordsInText": { "ignore": ["Obituary"] } },
  "aiInstruction": "Write one line in this form, omitting any part the document does not state: Died <date>; Born <date>; Attended Ricks College. Use ISO dates (YYYY-MM-DD). Include the last clause only if the document says the person attended Ricks College or BYU-Idaho.",
  "columns": [
    { "path": "attachment name", "sources": [{ "filename": true }], "locked": true },
    { "path": "MWDL/identifier", "sources": [{ "filename": true }] },
    { "path": "MWDL/title", "sources": [{ "join": "Alumni Obituary: {first} {last}" }, { "filenameStem": true }] },
    {
      "path": "BYUI_extended/BYUI_information/special_collections/alumni_obituary/death_date",
      "as": "death_date",
      "flagIfEmpty": true,
      "sources": [
        { "dateNear": ["passed away", "died", "returned home", "graduated this world"] },
        { "datePair": "second" }
      ],
      "transform": "date"
    },
    {
      "path": "MWDL/coverage",
      "as": "birth_date",
      "composeOnly": true,
      "sources": [
        { "dateNear": ["was born on", "was born", "born on", "Born"] },
        { "datePair": "first" }
      ],
      "transform": "date"
    },
    {
      "path": "MWDL/relation",
      "as": "ricks",
      "composeOnly": true,
      "sources": [
        {
          "presence": {
            "any": ["Ricks College", "Rick's College", "BYU-Idaho", "BYU Idaho"],
            "then": "Attended Ricks College"
          }
        }
      ]
    },
    {
      "path": "MWDL/description",
      "sources": [{ "compose": "Died {death_date}; Born {birth_date}; {ricks}" }, { "ai": true }]
    },
    { "path": "MWDL/genres/genre", "sources": [], "default": "Alumni Obituary" },
    { "path": "MWDL/subjects/subject", "sources": [], "default": "History; Religion; MCK Special Collections" },
    { "path": "MWDL/contributors/contributor", "sources": [], "default": "BYUI Alumni Office" },
    { "path": "MWDL/conversionSpecifications", "sources": [], "default": "Scanned to PDF" },
    { "path": "MWDL/source", "sources": [], "default": "None" },
    { "path": "BYUI_extended/byui_rights/restrict_to_byui", "sources": [], "default": "Public" }
  ]
}
