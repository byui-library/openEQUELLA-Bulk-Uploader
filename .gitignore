# ---------------------------------------------------------------------------
# Source media. Batches run to several GB; these are inputs, never artifacts.
# ---------------------------------------------------------------------------
files/

# ---------------------------------------------------------------------------
# Metadata spreadsheets. Real batches carry student names tied to recorded
# performances, so they stay out of history entirely. Anonymized test fixtures
# under tests/fixtures/ are the exception.
# ---------------------------------------------------------------------------
*.xlsx
*.xls
*.csv
!tests/fixtures/**/*.csv
# The starter-kit template (resources/template/) is a fabricated, generic
# example row -- no real student data, ever -- shipped deliberately so the
# app has something to hand the operator. Same exception shape as the test
# fixtures above, for the same reason.
!resources/template/**/*.csv

# ---------------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# Authorization-code token cache (src/core/tokenStore.ts). Short-lived,
# user-scoped bearer credential -- never belongs in history.
.oeq-token.json

# ---------------------------------------------------------------------------
# Node
# ---------------------------------------------------------------------------
node_modules/
dist/
dist-desktop/
build/
release/
*.tsbuildinfo
npm-debug.log*

# ---------------------------------------------------------------------------
# Runtime job state. Manifests reference absolute local paths and upload
# progress; they are per-machine and not shared.
# ---------------------------------------------------------------------------
jobs/
*.log

# ---------------------------------------------------------------------------
# Editor / tooling
# ---------------------------------------------------------------------------
.qodo/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Real files used for hands-on trials of the extractor. Never committed:
# size, and they are whatever the operator happened to point the tool at.
tests/test files/

# Real scanned obituaries, used for hands-on trials of the description work.
# These name deceased people and state their birth and death dates, so they
# are personal data about identifiable individuals in a PUBLIC repository --
# the exact material that had to be scrubbed out of tests, docs and source
# comments once already (see the pseudonym rule in CLAUDE.md). They arrived
# untracked and NOT ignored, one `git add -A` away from being published.
tests/obits/
obits/
