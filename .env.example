# openEQUELLA instance. REQUIRED, in every auth mode.
#
# HTTPS is required, not preferred, and `normaliseInstanceUrl` enforces it:
# openEQUELLA's /api/auth/login takes the password as a QUERY PARAMETER, so
# over http it would travel in clear text in the request line. A loopback
# address is the one exemption -- its traffic never leaves the machine.
#
# BYU-Idaho's are https://content.byui.edu and https://content-test.byui.edu.
# They are named here as an example, not as a default: the collection uuid is
# IDENTICAL on both, so this variable is the only thing distinguishing test
# from production. Check it before every run.
OEQ_BASE_URL=

# Sign-in method: code | client_credentials | password
#
# UNSET MEANS `code`, not `password`. That matters: a site that fills in
# OEQ_USERNAME and OEQ_PASSWORD below and sets nothing here silently gets
# OAuth, and openEQUELLA answers with "No OAuth client can be found with the
# supplied client_id (null)" -- naming neither the variables they set nor the
# one they didn't. `oeq-upload check` reports which mode was actually used, on
# the success path as well as the failure one, for exactly this reason.
#
#   password            openEQUELLA's own username/password sign-in. The
#                       simplest option, and the right one for an institution
#                       that is not behind SSO. UNVERIFIED against a live
#                       non-SSO instance -- see README, "What is and is not
#                       verified".
#   code                Authorization-code flow. One interactive browser
#                       sign-in per session; items are owned by whoever signs
#                       in. This is the working path at BYU-Idaho, which is
#                       Okta-backed.
#   client_credentials  Only works if the OAuth client was registered with a
#                       fixed user. BYU-Idaho's deliberately was not -- probed
#                       2026-08-12, it answers `invalid_client`.
OEQ_AUTH_MODE=password

# Required when OEQ_AUTH_MODE=password. Nothing else needs them.
#
# The password is held for the life of the process and never written to disk
# by the CLI; only the desktop app persists it, encrypted per Windows account.
# It never reaches an error message, a log line or the job manifest --
# tests/passwordAuth.test.ts walks every string reachable from a thrown error
# to hold that.
OEQ_USERNAME=
OEQ_PASSWORD=

# Required when OEQ_AUTH_MODE is `code` or `client_credentials`. An admin
# registers the API client in the openEQUELLA admin console. Not needed at all
# in password mode -- an institution using it has no OAuth client.
OEQ_CLIENT_ID=
OEQ_CLIENT_SECRET=

# Optional, and only read in `code` mode. Defaults to OEQ_BASE_URL with a
# trailing slash added back -- that is what BYU-Idaho's client is registered
# with, and confirmed live: the same URL WITHOUT the slash fails with "No
# OAuth client can be found ...". It is sent VERBATIM, never normalised, so
# whatever you set must match the client's registered redirectUrl
# character-for-character. Set it to a loopback callback
# (http://localhost:8787/callback) if an admin registers a dedicated client
# for this tool, and `login` will capture the code itself instead of asking
# you to paste it.
# OEQ_REDIRECT_URI=

# REQUIRED: which collection items are contributed to, in every auth mode.
#
# There is no default -- there used to be, and an institution that never set
# this silently got BYU-Idaho's collection uuid and a not-found from the
# server naming an identifier they had never chosen. The mode decides how you
# sign in, not whether you need somewhere to contribute to.
#
# To find yours: run `oeq-upload check`, which reports how many collections
# this account can create in, or use the desktop app's Setup screen, which
# lists them by name.
# BYU-Idaho Faculty Content is bb348ab1-7a81-4e37-8ef7-adc095ade4f9.
OEQ_COLLECTION_UUID=

# Optional. Recorded in the job manifest and sent nowhere. Schema validation
# reads a schema fetched from the API (cached per instance) or the local
# `--schema-file` export. Safe to leave blank.
# BYU-Idaho's BYUI_MWDL schema is c93181f3-a443-41bf-9afe-ac9f7daf90b7.
OEQ_SCHEMA_UUID=

# Optional. A metadata xpath that should also receive each item's attachment
# uuid -- a convenience index some schemas declare beside the attachment
# itself. BYU-Idaho sets it to `BYUI_extended/attachments/attachment`; most
# schemas have no such node.
#
# LEAVE IT BLANK AND NO SUCH FIELD IS WRITTEN AT ALL. That is the default and
# the right answer for a schema with no such node: writing to a path the
# collection's schema does not have stores junk or fails the create, on every
# item. The attachment is unaffected either way -- attachments are linked
# through the attachment API, not through this field.
#
# A leading slash is stripped, so a path pasted from a schema browser
# (`/BYUI_extended/attachments/attachment`) works as well as header form.
#
# `oeq-upload check` reports whether this is set and, if it is, whether the
# path actually exists in the target collection's schema.
#
# THE DESKTOP APP DOES NOT READ THIS. It is a per-instance setting collected
# on Setup, on purpose: the operator launches the packaged app from a Start
# Menu shortcut with no environment set, and an env fallback that only worked
# on a developer's machine is how a silent regression hid here once already.
OEQ_ATTACHMENT_UUID_PATH=

# Optional, and only read in `code` mode: where to cache the access token.
# Defaults to `.oeq-token.json` in the current directory (gitignored).
# OEQ_TOKEN_STORE_PATH=

# ---------------------------------------------------------------------------
# Language model, for `oeq-upload extract --ai`. Six variables, all optional.
# ---------------------------------------------------------------------------
#
# LEAVE OEQ_MODEL_BASE_URL BLANK AND THE FEATURE DOES NOT EXIST. No endpoint is
# contacted, nothing is prompted, and extraction is byte-for-byte what it was
# before this feature was built. That is what lets the tool be adopted by an
# institution that has not had a data review. `--ai` is a separate switch: with
# no endpoint set it is an ERROR rather than a silent no-op, because an explicit
# instruction that cannot be carried out must say so.
#
# OUTPUT QUALITY IS UNVERIFIED. The machinery is tested; nothing can assert that
# a generated description is good, and nothing has yet been run against a real
# model. Every model-written cell is flagged in `_notes` for you to check.
#
# The endpoint, up to and including /v1. THE SWITCH -- see above. Any
# OpenAI-compatible service: Ollama, LM Studio, llama.cpp, OpenAI, Azure OpenAI,
# Groq, Together, OpenRouter. Anthropic's and Google's own APIs do not speak
# this wire format.
#
# A HOSTED ADDRESS SENDS YOUR DOCUMENT TEXT OFF THE MACHINE -- up to
# OEQ_MODEL_BUDGET characters of every file, to a third party under their terms.
# An institution whose material cannot leave site should use a local runtime:
# http://localhost:11434/v1 is Ollama's.
OEQ_MODEL_BASE_URL=

# The model's name AT THAT ENDPOINT -- 'llama3', 'gpt-4o-mini'. NO DEFAULT, and
# setting the base URL without this is refused before a single file is read.
# It used to be coerced to an empty string, which put every document on the wire
# with `"model": ""` -- all failing, all charged for by whatever a gateway
# charges for accepting a request, from one unset variable.
OEQ_MODEL=

# Bearer key. LEAVE EMPTY FOR A LOCAL RUNTIME, which needs none.
#
# Refused over plain http to anywhere but this machine: a bearer key in clear
# text is a key disclosed. https is fine; so is plain http to loopback, which is
# what every local runtime serves. The key is sent as a header, never in a URL,
# and is redacted out of every error message before that message is truncated.
OEQ_MODEL_KEY=

# Optional. Characters to send from ONE document. Default 8000.
#
# A page of prose is well under it, so most documents go whole -- which matters,
# because a death date can be in the last line and leading-N-characters would
# throw it away. Beyond the budget, only the opening and any headed sections the
# profile names are sent, and every affected cell's note says so. A smaller
# model wants a smaller number. A value that is not a positive number is refused,
# naming this variable.
# OEQ_MODEL_BUDGET=8000

# Optional. Most REQUESTS one run may make. Default 500.
#
# REQUESTS, NOT DOCUMENTS. One call is made per cell a model may fill, so a
# profile with two such columns costs two per document; described as "documents"
# a ceiling would understate what it stops. Anything past the cap is left blank
# and flagged. Zero is legal and means "make no requests at all".
# OEQ_MODEL_CAP=500

# Optional. Seconds to wait for ONE answer. Default 120.
#
# NOT THE USUAL THIRTY. A hosted model answers a prompt this size in single-digit
# seconds, but a quantised 7B on a CPU can take ninety and be perfectly healthy --
# and abandoning it spends the compute, blanks the cell, and reports "this does
# not work" about a configuration that does. Named and checked in SECONDS, the
# unit you type, not the milliseconds the code uses.
# OEQ_MODEL_TIMEOUT_SECONDS=120
