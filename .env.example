# openEQUELLA instance
OEQ_BASE_URL=https://content-test.byui.edu

# OAuth client credentials. Register an API client in the admin console.
OEQ_CLIENT_ID=
OEQ_CLIENT_SECRET=

# Authentication mode: "code" (default) uses the authorization-code flow --
# the operator signs in via SSO in a browser once per session and pastes back
# the code; items are owned by whoever logs in. "client_credentials" only
# works if the OAuth client above was registered with a fixed user -- ask
# before assuming this instance's client is (it deliberately is not, so each
# contributor owns what they upload).
# OEQ_AUTH_MODE=code

# Registered redirect URI for the authorization-code flow. Defaults to
# OEQ_BASE_URL (trailing slash stripped) -- the registered redirectUrl on
# this instance is the site root, not a local callback, so there's nothing
# else it could sensibly be. Only set this if the OAuth client is registered
# with a different redirect URI.
# OEQ_REDIRECT_URI=

# REQUIRED: which collection items are contributed to. There is no default --
# there used to be, and an institution that never set this silently got
# BYU-Idaho's collection uuid and a not-found from the server naming an
# identifier they had never chosen.
OEQ_COLLECTION_UUID=bb348ab1-7a81-4e37-8ef7-adc095ade4f9

# Optional. Recorded in the job manifest and sent nowhere; schema validation
# reads the local schema export. Safe to leave blank.
OEQ_SCHEMA_UUID=c93181f3-a443-41bf-9afe-ac9f7daf90b7

# Optional. A metadata xpath that should also receive each item's attachment
# uuid -- a convenience index some schemas declare beside the attachment
# itself. BYU-Idaho's schema declares the one below; most do not.
#
# LEAVE IT BLANK AND NO SUCH FIELD IS WRITTEN AT ALL. That is the right answer
# for a schema with no such node: writing to a path the collection's schema
# does not have stores junk or fails the create, on every item. The attachment
# is unaffected either way -- attachments are linked through the attachment
# API, not through this field.
#
# `oeq-upload check` reports whether this is set and, if it is, whether the
# path actually exists in the target collection's schema.
OEQ_ATTACHMENT_UUID_PATH=BYUI_extended/attachments/attachment
